{
  "name": "channel-challenge",
  "version": "1.0.0",
  "description": "The Channel Challenge: trivia multijugador con apuestas en tiempo real",
  "scripts": {
    "dev": "concurrently -k -n server,web -c cyan,magenta \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "node --disable-warning=ExperimentalWarning --import tsx --watch server/index.ts",
    "dev:web": "vite",
    "build": "tsc --noEmit && vite build",
    "start": "NODE_ENV=production node --disable-warning=ExperimentalWarning --import tsx server/index.ts",
    "test": "node --disable-warning=ExperimentalWarning --import tsx --test tests/*.test.ts",
    "db:sql": "node --disable-warning=ExperimentalWarning --import tsx scripts/export-sql.ts",
    "load-test": "node --disable-warning=ExperimentalWarning --import tsx scripts/load-test.ts"
  },
  "dependencies": {
    "express": "^4.22.3",
    "socket.io": "^4.8.4",
    "tsx": "^4.23.15"
  },
  "devDependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^8.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@tailwindcss/vite": "^4.3.5",
    "@types/canvas-confetti": "^1.9.0",
    "@types/express": "^4.17.25",
    "@types/node": "^22.20.5",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "canvas-confetti": "^1.9.4",
    "concurrently": "^9.2.5",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.6",
    "socket.io-client": "^4.8.4",
    "tailwindcss": "^4.3.5",
    "typescript": "^5.9.3",
    "vite": "^6.4.6"
  },
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13"
  }
}
